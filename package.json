{
  "name": "manifest",
  "version": "0.1.0",
  "private": true,
  "description": "MANIFEST \u2014 a personal relationship system for the principal of Sea King Capital LLC.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "bootstrap:owner": "tsx --env-file-if-exists=.env.local scripts/bootstrap-owner.ts",
    "fixtures:load": "tsx --env-file-if-exists=.env.local scripts/fixtures.ts load",
    "fixtures:clear": "tsx --env-file-if-exists=.env.local scripts/fixtures.ts clear",
    "db:push": "supabase db push",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "db:types": "supabase gen types typescript --local > src/lib/db/database.types.ts",
    "ci": "npm run typecheck && npm run db:verify && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tailwindcss/postcss": "^4.3.3",
    "libphonenumber-js": "^1.12.10",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
