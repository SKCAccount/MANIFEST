          { "email": "erica@gendellpartners.com", "name": "Erica Gendell", "responseStatus": "accepted" },
          { "email": "mvance@carltonfields.com", "name": "Marcus Vance", "responseStatus": "tentative" },
          { "email": "room-14b@seakingcapital.com", "name": "Conference Room 14B", "responseStatus": "accepted", "resource": true }
