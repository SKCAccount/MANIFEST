# MANIFEST — environment.
#
# Copy to .env.local and fill in. No secrets live in the repository; .env.local
# is gitignored.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security. Server-side only — no NEXT_PUBLIC_ prefix, so
# Next refuses to inline it into client code. Used by sync jobs, merges and
# guarded exports.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# The single account this instance belongs to. Registered in app_owners by
# `npm run bootstrap:owner`, which is what every RLS policy checks.
MANIFEST_OWNER_EMAIL=

# Where magic links come back to. Must match a Redirect URL allowlisted under
# Supabase → Authentication → URL Configuration, or the link will bounce.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google (Phase 2 — Gmail and Calendar sync)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Comma-separated. Identifies the operator's own addresses so sync can tell
# which side of a thread is his — and therefore which touchpoints are inbound,
# which is what drives promotion. Getting this wrong inverts the rule silently.
MANIFEST_OWN_DOMAINS=seakingcapital.com

# Restricts Gmail sync to a labelled subset. Leave empty to sync all mail.
# See the open question in README §Flags.
MANIFEST_GMAIL_LABEL=

# ---------------------------------------------------------------------------
# LLM (quick capture parsing, batch touchpoint summaries)
# ---------------------------------------------------------------------------
# Message bodies are never stored. Summaries are two sentences and the Gmail
# permalink is kept instead.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret Vercel cron sends so job endpoints reject anything else.
CRON_SECRET=
