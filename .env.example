# MANIFEST — environment.
#
# Copy to .env.local and fill in. No secrets live in the repository; .env.local
# is gitignored.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Supabase renamed its API keys in 2025. Older projects issue legacy JWT keys
# (anon / service_role); newer ones issue sb_publishable_... / sb_secret_...
# under new dashboard names. Use whichever pair your project shows — both
# spellings below are read, and whichever is set wins.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bypasses row level security. Server-side only — no NEXT_PUBLIC_ prefix, so
# Next refuses to inline it into client code. Used by sync jobs and merges.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# The single account this instance belongs to. Registered in app_owners by
# `npm run bootstrap:owner`, which is what every RLS policy checks.
MANIFEST_OWNER_EMAIL=

# Where magic links come back to. Must match a Redirect URL allowlisted under
# Supabase → Authentication → URL Configuration, or the link will bounce.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google (Phase 2 — Gmail and Calendar sync)
# ---------------------------------------------------------------------------
# All three, or none. Leave them empty and sync runs against the fixtures in
# src/lib/sync/google/fixtures/ — every screen works, the mail is invented, and
# every run is recorded as provider_kind = 'fixture' so it can never be mistaken
# for the real mailbox.
#
# Scopes are gmail.readonly and calendar.readonly. Sync never writes to Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Comma-separated. Identifies the operator's own addresses so sync can tell
# which side of a thread is his — and therefore which touchpoints are inbound,
# which is what drives promotion.
#
# Sync refuses to start without it, rather than degrading. With no own-domains
# every message the operator sent reads as inbound, inbound promotes, and the
# entire watchlist flips to active — which cannot be undone, because an active
# record can never be returned to the watchlist.
MANIFEST_OWN_DOMAINS=seakingcapital.com

# Restricts Gmail sync to a labelled subset. Empty means all mail, which is the
# settled choice — see README §11. Kept as an escape hatch in case the noise
# ever outweighs the recall; nothing else depends on it being set.
MANIFEST_GMAIL_LABEL=

# With no Google app configured, sync replays canned fixture mail — but only
# against a local stack. On a hosted project it refuses instead, so a stray
# "Sync now" can never write invented people into a real review queue. Set to 1
# only on a scratch project where the demo data is the point.
# MANIFEST_ALLOW_FIXTURE_SYNC=1

# ---------------------------------------------------------------------------
# LLM (quick capture parsing, synced thread summaries)
# ---------------------------------------------------------------------------
# Optional everywhere. Without it, quick capture falls back to the manual form
# and a synced touchpoint keeps its subject line instead of a summary.
#
# Message bodies are never *fetched*, let alone stored: sync asks Gmail for
# format=metadata, so what the summarizer sees is the subject line and Google's
# own ~200-character snippet. The permalink is stored so the real thread is one
# click from the timeline.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret the scheduled runs send so /api/cron/* rejects anything else.
# Unset means every request is rejected, including the scheduled ones — an
# endpoint that reads a mailbox should fail closed. Schedules are in vercel.json.
CRON_SECRET=
